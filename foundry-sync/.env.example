# Скопіюйте у .env і заповніть. Файл .env у git не потрапляє.

# Supabase → Project Settings → API
SUPABASE_URL=https://dmqkxxedabawnhznzlmx.supabase.co
# service_role key (секретний! лише на сервері, ніколи в апці чи в git)
SUPABASE_SERVICE_ROLE_KEY=

# Повний шлях до папки Data вашого Foundry (там, де worlds/, modules/, systems/ лежать поруч).
# Наприклад: /home/foundry/foundrydata/Data
FOUNDRY_DATA=

# Підпапка в Data для артів гравців і частота перевірки (секунди).
ART_ROOT=pilots
POLL_SECONDS=15
