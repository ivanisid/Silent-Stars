# systemd-сервіс: синхронізатор стартує разом із сервером і перезапускається при збої.
# Встановлення — див. README.md. Замініть User і WorkingDirectory на свої.

[Unit]
Description=OMPCON art sync -> Foundry VTT
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Той самий користувач, від якого працює Foundry — щоб файли мали ті самі права.
User=foundry
WorkingDirectory=/home/foundry/foundry-sync
ExecStart=/usr/bin/env node index.mjs
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
